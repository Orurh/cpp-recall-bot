{
  "exercise_id": "take_prefix",
  "exercise_revision": 1,
  "suite_id": "take_prefix-public-v1",
  "cases": [
    {"id": "empty_zero", "title": "Пустой ввод, ноль", "pending": [], "limit": 0, "expected": {"result": [], "pending": []}},
