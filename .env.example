TELEGRAM_BOT_TOKEN=
POSTGRES_DB=cpp_recall_bot
POSTGRES_USER=cpp_recall
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

DATABASE_URL=postgresql://cpp_recall:change-me@localhost:5432/cpp_recall_bot
DATABASE_POOL_SIZE=5

# Public HTTPS URL configured as the bot's Telegram Mini App.
# The built-in HTTP server serves this path behind your TLS reverse proxy.
# MINI_APP_URL=https://learn.example.com/
MINI_APP_LISTEN_ADDRESS=127.0.0.1
MINI_APP_PORT=8080
MINI_APP_STATIC_DIR=docs/miniapp
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
MINI_APP_WORKER_COUNT=4
# Public bot username (without @). Enables sharing reviewed tasks; Main Mini App
# must be configured in BotFather. Use your own bot name for a separate instance;
# 'off' disables outgoing sharing. The project default is cpp_recall_bot.
MINI_APP_BOT_USERNAME=cpp_recall_bot
# Telegram user ID of the owner: private feedback, beta statistics and monitoring alerts.
# Leave empty to disable owner access. See docs/BETA_MONITORING.md.
MINI_APP_FEEDBACK_ADMIN_ID=
