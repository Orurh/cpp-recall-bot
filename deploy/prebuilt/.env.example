# Заготовка. Не использовать настоящие секреты в репозитории.
# После публикации образа: ghcr.io/orurh/cpp-recall-bot@sha256:<64 hex characters>
CPP_RECALL_IMAGE=
TELEGRAM_BOT_TOKEN=
MINI_APP_URL=
POSTGRES_DB=cpp_recall_bot
POSTGRES_USER=cpp_recall
# Новый случайный пароль из hex-символов: без проблем экранирования в DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_POOL_SIZE=2
MINI_APP_WORKER_COUNT=2
MINI_APP_FEEDBACK_ADMIN_ID=
